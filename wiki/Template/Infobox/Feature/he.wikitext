<noinclude><languages/></noinclude><includeonly><infobox type="Feature" theme="community">
	<title source="name"><default>'''חסר שם!'''</default></title>
	{{#if: {{{image}}} |  <image source="image"></image>}}
    <data source="platforms"><label>פלטפורמות</label></data>
    <data source="vr">
        <label>VR בלבד</label>
    </data>
    <data source="vrchatplus">
        <label><span style="margin-inline-end:0.3rem;>[[File:Icon_VRC_Plus_Icon.png|frameless|14x14px]]</span>[[Special:MyLanguage/VRC%2B|VRC+]]</label>
    </data>
    <group>
        <header>היסטוריית גרסאות</header>
        <panel>
            {{#if: {{{branch_live_date}}} |
                <section>
                    <label>גרסה חיה (Live)</label>
                    <data source="branch_live_date">
                        <label>תאריך</label>
                        <format>{{Date|{{{branch_live_date}}}}}</format>
                    </data>
                    <data source="branch_live_version"><label>גרסה</label></data>
                    <data source="branch_live_releasenote"><label>הערות הגרסה</label></data>
                </section>
            }}
            {{#if: {{{branch_openbeta_date}}} |
                <section>
                    <label>בטא פתוחה</label>
                    <data source="branch_openbeta_date">
                        <label>תאריך</label>
                        <format>{{Date|{{{branch_openbeta_date}}}}}</format>
                    </data>
                    <data source="branch_openbeta_version"><label>גרסה</label></data>
                    <data source="branch_openbeta_releasenote"><label>הערות הגרסה</label></data>
                </section>
            }}
            {{#if: {{{branch_announcement_date}}} |
                <section>
                    <label>הודעה</label>
                    <data source="branch_announcement_date">
                        <label>תאריך</label>
                        <format>{{Date|{{{branch_announcement_date}}}}}</format>
                    </data>
                    <data source="branch_announcement_link"><label>קישור</label></data>
                </section>
            }}
        </panel>
    </group>
</infobox></includeonly><noinclude>{{Documentation}}</noinclude>